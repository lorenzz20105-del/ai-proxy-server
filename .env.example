# ─────────────────────────────────────────────────────────────────────────────
#  AI Proxy Server — every setting, with the value that actually applies.
#  Copy to `.env` and edit. Nothing here is required: sensible defaults apply.
# ─────────────────────────────────────────────────────────────────────────────

# ── server ───────────────────────────────────────────────────────────────────
PROXY_HOST=0.0.0.0
PROXY_PORT=8000
# where the SQLite database and generated files live
PROXY_DATA_DIR=./data

# seconds before an upstream request is considered dead
PROXY_REQUEST_TIMEOUT=120
# streams can legitimately take much longer
PROXY_STREAM_TIMEOUT=900
PROXY_CONNECT_TIMEOUT=15

PROXY_MAX_BODY_BYTES=10485760
PROXY_CORS_ORIGINS=*
PROXY_LOG_LEVEL=INFO
# true = structured JSON logs (for shipping), false = human-readable
PROXY_LOG_JSON=true
PROXY_LOG_RETENTION_DAYS=14


# ── authentication ───────────────────────────────────────────────────────────
# The master key has full admin rights, and it is what the bundled console asks
# for. Left empty it falls back to the built-in default:
#
#     sk-proxy-default-master-key
#
# so a fresh checkout is usable immediately (and the console clears its key gate
# on its own, because only that public default is ever injected into the page).
# Set PROXY_MASTER_KEY to anything else before exposing the port — a custom key
# is never written into the dashboard.
PROXY_MASTER_KEY=

# Encrypts upstream API keys at rest. Generate with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Requires the optional `cryptography` package; without it a weak fallback is used
# and a warning is logged. NEVER change this after storing accounts — you will not
# be able to decrypt the existing secrets.
PROXY_ENCRYPTION_KEY=


# ── accounts ─────────────────────────────────────────────────────────────────
# On first boot the proxy seeds accounts from these keys (they are ignored if
# accounts already exist in the database).
OPENAI_KEY_1=
OPENAI_KEY_2=
ANTHROPIC_KEY_1=
GOOGLE_KEY_1=

# Full control: a JSON array of account objects, see docs/API.md
# PROXY_SEED_ACCOUNTS=[{"name":"openai-primary","provider_type":"openai","base_url":"https://api.openai.com/v1","api_key":"sk-...","models":["gpt-4o"]}]


# ── routing ──────────────────────────────────────────────────────────────────
# round_robin | failover | weighted | random | least_latency | least_cost
#   | least_requests | priority
PROXY_ROUTING=round_robin
PROXY_MAX_ATTEMPTS=3
PROXY_RETRY_BACKOFF=0.35
PROXY_RETRY_MAX_BACKOFF=4.0
PROXY_RETRY_JITTER=true
PROXY_RETRY_STATUS_CODES=408,409,425,429,500,502,503,504,529

# exact = an account must list the model; prefix = longest-prefix match
PROXY_MODEL_MATCHING=exact
# reject requests for models no account serves
PROXY_STRICT_MODELS=false


# ── circuit breaker ──────────────────────────────────────────────────────────
PROXY_CB_FAILURE_THRESHOLD=5
PROXY_CB_SUCCESS_THRESHOLD=2
PROXY_CB_COOLDOWN=45
PROXY_CB_HALF_OPEN_CONCURRENCY=1


# ── session affinity ─────────────────────────────────────────────────────────
PROXY_SESSION_AFFINITY=true
PROXY_SESSION_AFFINITY_TTL=1800
PROXY_SESSION_HEADER=x-session-id


# ── cache ────────────────────────────────────────────────────────────────────
PROXY_CACHE_ENABLED=true
PROXY_CACHE_TTL=300
PROXY_CACHE_MAX_ENTRIES=2000
# only store responses that are reproducible (temperature=0 or a fixed seed)
PROXY_CACHE_DETERMINISTIC_ONLY=true


# ── budget ───────────────────────────────────────────────────────────────────
# 0 disables the limit entirely
PROXY_DAILY_BUDGET_USD=0
PROXY_MONTHLY_BUDGET_USD=0
PROXY_BUDGET_HARD_STOP=true


# ── background tasks ─────────────────────────────────────────────────────────
# periodically re-probe unhealthy accounts (never blindly "reset to healthy")
PROXY_ACTIVE_PROBE=true
PROXY_ACTIVE_PROBE_INTERVAL=120
PROXY_USAGE_ACCOUNTING=true